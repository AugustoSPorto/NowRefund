<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>false</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Client script that validates the purchase date field on refund requests, preventing future dates from being submitted.</description>
        <field>purchase_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }

    // Get the date entered by the user
    var purchaseDate = new Date(newValue);

    // Get today's date and reset time to midnight for a fair comparison
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    // Check if the purchase date is in the future
    if (purchaseDate > today) {
        // Display an error message directly on the field
        g_form.addErrorMessage("The purchase date cannot be a future date. Please enter a valid date.");

        // Clear the field value to force the user to correct it
        g_form.setValue("purchase_date", "");

    } else {
        // Valid date: clear any previous error message
		g_form.clearMessages();
    }
}]]></script>
