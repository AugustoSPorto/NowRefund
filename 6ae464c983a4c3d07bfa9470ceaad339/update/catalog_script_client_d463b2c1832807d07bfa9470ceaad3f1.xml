        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

	// Format 0,00 or 0.00
    var regex = /^\d+([.,]\d{1,2})?$/;

    if (!regex.test(newValue)) {
        // Shows error message
        g_form.addErrorMessage('Invalid Format. Insert a real price! (150 or 150.50 or 150,50)');
        // Clears the field
        g_form.setValue('amount_brl','');
    } else {
        // If correct, clears all previous error messages
		g_form.clearMessages();
    }

}]]></script>
